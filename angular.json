{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "portafolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/barlow-condensed/latin-700.css",
              "node_modules/@fontsource/barlow-condensed/latin-800.css",
              "node_modules/@fontsource/barlow/latin-400.css",
              "node_modules/@fontsource/barlow/latin-500.css",
              "node_modules/@fontsource/barlow/latin-600.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
              "node_modules/@fontsource/space-grotesk/latin-500.css",
              "node_modules/@fontsource/space-grotesk/latin-700.css",
              "node_modules/@fontsource/dm-sans/latin-400.css",
              "node_modules/@fontsource/dm-sans/latin-500.css",
              "node_modules/@fontsource/dm-sans/latin-700.css",
              "node_modules/@fontsource/poppins/latin-400.css",
              "node_modules/@fontsource/poppins/latin-600.css",
              "node_modules/@fontsource/poppins/latin-700.css",
              "node_modules/@fontsource/inter/latin-400.css",
              "node_modules/@fontsource/inter/latin-600.css",
              "node_modules/@fontsource/inter/latin-700.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": ["localhost", "192.168.1.32"]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": ["localhost", "192.168.1.32"]
          },
          "configurations": {
            "production": {
              "buildTarget": "portafolio:build:production"
            },
            "development": {
              "buildTarget": "portafolio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
